#!/bin/sh
set -e

if git diff --cached --quiet --diff-filter=ACMR -- '*.rs'; then
    exit 0
fi

# Check only: formatting and re-staging here would include unstaged changes
# from partially staged files in the commit.
if ! cargo fmt --check; then
    printf '%s\n' 'Formatting check failed. Run cargo fmt, review the changes, and stage the intended changes before committing again.' >&2
    exit 1
fi
